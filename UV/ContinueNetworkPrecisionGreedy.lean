import UV.ContinueNetworkPrecision
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-! The greedy selection scans the original finite rows from largest
Schwinger weight to smallest. Every prefix keeps its exact span. -/

noncomputable section

open scoped BigOperators

namespace UV.ContinueNetworkPrecision

variable {M : Type*} [AddCommGroup M] [Module ℝ M] {N : ℕ}

/-- The span generated by the indicated original rows. -/
def rowSpan (rows : Fin N → M) (s : Finset (Fin N)) : Submodule ℝ M :=
  Submodule.span ℝ (rows '' (s : Set (Fin N)))

theorem rowSpan_mono (rows : Fin N → M) {s t : Finset (Fin N)} (h : s ⊆ t) :
    rowSpan rows s ≤ rowSpan rows t :=
  Submodule.span_mono (Set.image_mono h)

/-- Process row `n` only when it enlarges the span of the rows already
selected. The value after `N` steps is the selected complete row set. -/
def greedyRows (rows : Fin N → M) : ℕ → Finset (Fin N)
  | 0 => ∅
  | n+1 => by
    classical
    exact if hn : n < N then
      let i : Fin N := ⟨n,hn⟩
      if rows i ∈ rowSpan rows (greedyRows rows n) then greedyRows rows n
      else insert i (greedyRows rows n)
    else greedyRows rows n

private theorem greedyRows_step_mono (rows : Fin N → M) (n : ℕ) :
    greedyRows rows n ⊆ greedyRows rows (n+1) := by
  classical
  rw [greedyRows]
  split
  · dsimp only
    split
    · exact Finset.Subset.refl _
    · exact Finset.subset_insert _ _
  · exact Finset.Subset.refl _

theorem greedyRows_monotone (rows : Fin N → M) : Monotone (greedyRows rows) :=
  monotone_nat_of_le_succ (greedyRows_step_mono rows)

theorem greedyRows_mem_lt (rows : Fin N → M) (n : ℕ) {i : Fin N}
    (hi : i ∈ greedyRows rows n) : i.val < n := by
  induction n with
  | zero => simp [greedyRows] at hi
  | succ n ih =>
    rw [greedyRows] at hi
    split at hi
    · rename_i hn
      dsimp only at hi
      split at hi
      · exact (ih hi).trans (Nat.lt_succ_self _)
      · rcases Finset.mem_insert.mp hi with he | he
        · subst i
          exact Nat.lt_succ_self _
        · exact (ih he).trans (Nat.lt_succ_self _)
    · exact (ih hi).trans (Nat.lt_succ_self _)

/-- The rows selected in any prefix are genuinely independent. -/
theorem greedyRows_indep (rows : Fin N → M) (n : ℕ) :
    LinearIndepOn ℝ rows (greedyRows rows n : Set (Fin N)) := by
  classical
  induction n with
  | zero => simp [greedyRows]
  | succ n ih =>
    rw [greedyRows]
    split
    · dsimp only
      split
      · exact ih
      · rename_i h
        rw [Finset.coe_insert]
        exact ih.insert h
    · exact ih

/-- Every processed row belongs to the span as soon as that row has
been considered. This includes a discarded row. -/
theorem processed_row_mem_span (rows : Fin N → M) (i : Fin N) :
    rows i ∈ rowSpan rows (greedyRows rows (i.val+1)) := by
  classical
  rw [greedyRows, dif_pos i.isLt]
  dsimp only
  split
  · assumption
  · apply Submodule.subset_span
    exact ⟨i, Finset.mem_insert_self _ _, rfl⟩

/-- The selected rows retain precisely the row span of each processed
prefix, not only the final row span. -/
theorem greedyRows_prefix_span_eq (rows : Fin N → M) (n : ℕ) :
    rowSpan rows (greedyRows rows n) =
      Submodule.span ℝ (rows '' {i : Fin N | i.val < n}) := by
  apply le_antisymm
  · apply Submodule.span_mono
    rintro _ ⟨i,hi,rfl⟩
    exact ⟨i, greedyRows_mem_lt rows n hi, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨i,hi,rfl⟩
    exact rowSpan_mono rows (greedyRows_monotone rows (show i.val+1 ≤ n from hi))
      (processed_row_mem_span rows i)

/-- Later rows never change which rows were selected before a fixed
cut. This gives the actual finite coordinate flag. -/
theorem greedyRows_filter_prefix (rows : Fin N → M) {n m : ℕ} (hnm : n ≤ m) :
    (greedyRows rows m).filter (fun i => i.val < n) = greedyRows rows n := by
  classical
  induction m generalizing n with
  | zero =>
    have hn : n = 0 := Nat.eq_zero_of_le_zero hnm
    simp [hn, greedyRows]
  | succ m ih =>
    by_cases h : n ≤ m
    · rw [greedyRows]
      split
      · rename_i hn
        dsimp only
        split
        · exact ih h
        · rw [Finset.filter_insert, if_neg (Nat.not_lt.mpr h)]
          exact ih h
      · exact ih h
    · have hn : n = m + 1 := by omega
      subst n
      exact Finset.filter_eq_self.mpr fun i hi => greedyRows_mem_lt rows _ hi

theorem greedyRows_available (rows : Fin N → M) (r : Fin N) :
    availableRows (greedyRows rows N) r = greedyRows rows (r.val+1) := by
  unfold availableRows
  rw [← greedyRows_filter_prefix rows (n := r.val+1) (m := N) r.isLt]
  apply Finset.filter_congr
  intro i _
  exact Fin.le_iff_val_le_val.trans (Nat.lt_succ_iff).symm

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- The selected rows give explicit finite real expansions, using only
coordinates whose original weights are at least that of the expanded row. -/
theorem greedyRows_hasEarlierExpansion (rows : Fin N → V →ₗ[ℝ] ℝ) :
    ∃ coefficient : Fin N → Fin N → ℝ,
      hasEarlierExpansion rows (greedyRows rows N) coefficient := by
  classical
  have hFor (r : Fin N) : ∃ coefficient : Fin N → ℝ,
      (∑ i ∈ availableRows (greedyRows rows N) r, coefficient i • rows i) = rows r := by
    let b := availableRows (greedyRows rows N) r
    have hs : rows r ∈ rowSpan rows b := by
      unfold b
      rw [greedyRows_available]
      exact processed_row_mem_span rows r
    have hSubtype : rows r ∈ Submodule.span ℝ (rows '' (b : Set (Fin N))) := hs
    obtain ⟨c,hc⟩ := (Fintype.mem_span_image_iff_exists_fun ℝ).mp hSubtype
    let coefficient (i : Fin N) : ℝ := if hi : i ∈ b then c ⟨i,hi⟩ else 0
    refine ⟨coefficient, ?_⟩
    change (∑ i ∈ b, coefficient i • rows i) = rows r
    rw [← Finset.sum_coe_sort]
    calc
      _ = ∑ i : b, c i • rows i.1 := by
        apply Finset.sum_congr rfl
        intro i _
        exact congrArg (· • rows i.1) (dif_pos i.2)
      _ = _ := hc
  choose coefficient hc using hFor
  exact ⟨coefficient,hc⟩

/-- The actual greedy coordinates give the uniform two-sided Schwinger
precision comparison on the entire ordered sector. -/
theorem greedy_precision_compare (rows : Fin N → V →ₗ[ℝ] ℝ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (w : Fin N → ℝ) (k : V), (∀ i, 0 ≤ w i) → Antitone w →
      selectedPrecision rows (greedyRows rows N) w k ≤ rowPrecision rows w k ∧
      rowPrecision rows w k ≤ C * selectedPrecision rows (greedyRows rows N) w k := by
  obtain ⟨c,hc⟩ := greedyRows_hasEarlierExpansion rows
  exact precision_compare_of_earlierExpansion rows _ c hc

end UV.ContinueNetworkPrecision
